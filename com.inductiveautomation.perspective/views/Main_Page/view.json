                    "script": "\n    resetRequiredPath \u003d \"[default]vLock/Default/System/ResetRequired\"\n    vfd101RunPath \u003d \"[default]vLock/Default/VFDs/VFD-101/Cmd_Run\"\n    vfd102RunPath \u003d \"[default]vLock/Default/VFDs/VFD-102/Cmd_Run\"\n\n    resetRequired \u003d bool(\n        system.tag.readBlocking([resetRequiredPath])[0].value\n    )\n\n    if resetRequired:\n        system.perspective.print(\"Start blocked. Press Reset first.\")\n        return\n\n    system.tag.writeBlocking(\n        [\n            vfd101RunPath,\n            vfd102RunPath\n        ],\n        [\n            True,\n            True\n        ]\n    )"
