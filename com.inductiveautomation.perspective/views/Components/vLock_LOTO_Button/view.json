{
  "custom": {},
  "params": {
    "equipmentName": "VFD-101",
    "vfdPath": "[default]vLock/Default/VFDs/VFD-101"
  },
  "propConfig": {
    "params.equipmentName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.vfdPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 58,
      "width": 128
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "draggable": false,
                "id": "rUo-DeXr",
                "modal": false,
                "overlayDismiss": true,
                "position": {
                  "height": 300,
                  "relativeLocation": "bottom-right",
                  "width": 440
                },
                "positionType": "relative",
                "resizable": false,
                "showCloseIcon": true,
                "type": "open",
                "viewParams": {
                  "equipmentName": "{view.params.equipmentName}",
                  "vfdPath": "{view.params.vfdPath}"
                },
                "viewPath": "Popups/VFD_LOTO",
                "viewportBound": true
              },
              "scope": "C",
              "type": "popup"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "position": {
          "height": 1,
          "width": 1
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if(\r\n    tag({view.params.vfdPath} + \"/LOTO/Active\"),\r\n    \"#D32F2F\",\r\n    \"#1976D2\"\r\n)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.equipmentName}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "image": {
            "height": 12,
            "icon": {
              "path": "material/lock"
            },
            "width": 12
          },
          "style": {
            "fontSize": "10px"
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
}